rules_version = '2';
// Anyone you add under Firebase > Authentication > Users can use Xenoreads.
// Keep "Enable create (sign-up)" turned off there, so nobody else can make an account.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each person's own library, progress and bookmarks.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Shared by the family: narrated books, articles and read-along text.
    match /narrations/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
