rules_version = '2';
// Only your account can read or write anything. __OWNER_EMAIL__ is filled in at deploy
// time from the OWNER_EMAIL GitHub secret, so your email never sits in the code.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email.lower() == '__OWNER_EMAIL__';
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
